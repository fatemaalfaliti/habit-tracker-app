{
  "expo": {
    "name": "HabitTracker",
    "slug": "habit-tracker-app",
    "version": "1.0.0",
    "description": "Build good habits, track your daily progress and get reminders.",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F0FDFA"
    },
    "ios": {
      "bundleIdentifier": "com.fatemaalfaliti.habittracker",
      "buildNumber": "1",
      "supportsTablet": true,
      "infoPlist": {
        "NSUserNotificationsUsageDescription": "HabitTracker sends reminders so you don't forget your daily habits."
      }
    },
    "android": {
      "package": "com.fatemaalfaliti.habittracker",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F766E"
      },
      "permissions": ["POST_NOTIFICATIONS", "SCHEDULE_EXACT_ALARM"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/adaptive-icon.png",
          "color": "#0F766E"
        }
      ]
    ]
  }
}
